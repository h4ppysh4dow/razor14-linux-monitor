[Unit]
Description=Razor14 full-save CPU and GPU controller
Requires=cardwired.service tuned-ppd.service
After=cardwired.service tuned-ppd.service
Before=display-manager.service
[Service]
EnvironmentFile=/etc/razor14-monitor/power.env
Type=simple
ExecStart=/usr/local/libexec/razor14-power serve
ExecStopPost=/usr/local/libexec/razor14-power recover
Restart=on-failure
RestartSec=5
RuntimeDirectory=razor14-power
RuntimeDirectoryMode=0755
StateDirectory=razor14-power
StateDirectoryMode=0700
TimeoutStopSec=60
[Install]
WantedBy=multi-user.target
