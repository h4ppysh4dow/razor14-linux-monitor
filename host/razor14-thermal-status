#!/usr/bin/python3
import json, subprocess, re, sys, fcntl, time
from pathlib import Path
from rhinux_telemetry import guest_gpu
H=Path.home()
def read(p):
 try: return Path(p).read_text().strip()
 except OSError: return ''
def temp(base):
 for p in Path(base).glob('hwmon*/temp1_input'):
  try: return f'{int(read(p))/1000:.1f} °C'
  except ValueError: pass
 return '—'
def gpu(address):
 p=Path('/sys/bus/pci/devices')/address
 if address=='0000:01:00.0' and (p/'driver').resolve().name=='vfio-pci':
  return guest_gpu()
 state=read(p/'power/runtime_status')
 label={'active':'wach','suspended':'schläft','suspending':'schläft ein','resuming':'wacht auf'}.get(state,'unbekannt')
 result={'state':label,'temp':temp(p/'hwmon') if state=='active' else '—','load':'—'}
 if state=='suspended': result['load']='0%'
 elif state=='active':
  if address=='0000:04:00.0':
   value=read(p/'gpu_busy_percent')
   if value.isdigit(): result['load']=value+'%'
  elif not (H/'.cache/razor14-pause-nvidia').exists():
   try:
    r=subprocess.run(['nvidia-smi','--id=0000:01:00.0','--query-gpu=temperature.gpu,utilization.gpu','--format=csv,noheader,nounits'],capture_output=True,text=True,timeout=3)
    if r.returncode==0:
     t,u=[x.strip() for x in r.stdout.strip().split(',')]
     if t.isdigit(): result['temp']=t+' °C'
     if u.isdigit(): result['load']=u+'%'
   except (OSError,ValueError,subprocess.TimeoutExpired): pass
 return result
ac=read('/sys/class/power_supply/AC0/online')=='1'
error=''
power={'active':False,'requested':False,'available':False}
try:
 cmd='status'
 if len(sys.argv)>1 and sys.argv[1] in ('power-auto','power-save'):
  cmd='auto' if sys.argv[1]=='power-auto' else 'save'
  if cmd=='save':
   r=subprocess.run([str(H/'.local/bin/razer-cli'),'write','fan','bat','0'],capture_output=True,text=True,timeout=5)
   if 'result: true' not in r.stdout:raise RuntimeError('Lüfterautomatik konnte nicht gesetzt werden.')
 power=json.loads(subprocess.check_output([str(H/'.local/bin/razor14-power-client'),cmd],text=True,timeout=65))
 error=power.get('error','')
 if error=='RTX noch aktiv: GPU-Anwendungen schließen.':error='RTX noch nicht in D3cold; Systemzugriffe werden geprüft.'
except Exception as e:error=str(e)

cli=str(H/'.local/bin/razer-cli')
if len(sys.argv)>1 and sys.argv[1] not in ('power-auto','power-save'):
 if sys.argv[1] not in ['auto','max']: sys.exit(2)
 if not ac: error='Umschaltung nur im Netzbetrieb.'
 else:
  try:
   r=subprocess.run([cli,'write','fan','ac','0' if sys.argv[1]=='auto' else '5000'],capture_output=True,text=True,timeout=5)
   if 'result: true' not in r.stdout: error='Lüfterbefehl fehlgeschlagen.'
  except Exception: error='Lüfterdienst nicht erreichbar.'
try:
 r=subprocess.run([cli,'read','fan','ac' if ac else 'bat'],capture_output=True,text=True,timeout=4)
 m=re.search(r'Current fan setting: (.+)',r.stdout)
 fan=m.group(1) if m else 'nicht verfügbar'
except Exception: fan='nicht verfügbar'
cpu='—'
for p in Path('/sys/class/hwmon').glob('hwmon*'):
 if read(p/'name')=='k10temp':
  try: cpu=f'{int(read(p/"temp1_input"))/1000:.1f} °C'
  except ValueError: pass
# Aggregate CPU utilization since the preceding sample; guest time is
# already included in user/nice. Idle and I/O wait are not CPU execution.
cpu_load='—'
try:
 cache=H/'.cache/razor14-cpu-times.json'
 cache.parent.mkdir(parents=True,exist_ok=True)
 with cache.open('a+') as f:
  fcntl.flock(f,fcntl.LOCK_EX)
  f.seek(0)
  try: previous=json.load(f)
  except (ValueError,TypeError): previous={}
  ticks=[int(v) for v in Path('/proc/stat').read_text().splitlines()[0].split()[1:9]]
  total=sum(ticks); idle=ticks[3]+ticks[4]
  boot=read('/proc/sys/kernel/random/boot_id')
  dt=total-previous.get('total',total)
  di=idle-previous.get('idle',idle)
  if previous.get('boot')==boot and dt>0 and 0<=di<=dt:
   cpu_load=f'{100*(dt-di)/dt:.0f}%'
  f.seek(0); f.truncate()
  json.dump(dict(total=total,idle=idle,boot=boot),f)
except (OSError,ValueError,IndexError,TypeError): pass
cpu=cpu+'  '+cpu_load
rpm=[None,None]
try:
 r=subprocess.run([cli,'read','actual-fan'],capture_output=True,text=True,timeout=4)
 for line in r.stdout.splitlines():
  if line.startswith('TACHOMETER_JSON:'): rpm=json.loads(line.split(':',1)[1])
except Exception: pass
data=dict(cpu=cpu,amd=gpu('0000:04:00.0'),nvidia=gpu('0000:01:00.0'),fan='Automatisch' if fan=='Auto (0)' else fan,rpm=rpm,ac=ac,error=error)
def number(v):
 m=re.search(r'[0-9]+(?:\.[0-9]+)?',str(v))
 return float(m.group()) if m else None
point=dict(t=time.time(),cpu=number(cpu_load),amd=number(data['amd']['load']),rtx=number(data['nvidia']['load']),ct=number(cpu.split('°')[0]),at=number(data['amd']['temp']),nt=number(data['nvidia']['temp']),f1=rpm[0],f2=rpm[1])
history=[]
try:
 cache=H/'.cache/razor14-history.json'
 with cache.open('a+') as f:
  fcntl.flock(f,fcntl.LOCK_EX);f.seek(0)
  try: history=json.load(f)
  except (ValueError,TypeError): history=[]
  if not isinstance(history,list):history=[]
  history=[x for x in history if isinstance(x,dict) and point['t']-600 <= x.get('t',0) <= point['t']]
  if not history or point['t']-history[-1]['t']>=9:history.append(point)
  history=history[-61:]
  f.seek(0);f.truncate();json.dump(history,f)
except OSError:pass
data['history']=history
data['power']=power
print(json.dumps(data))
